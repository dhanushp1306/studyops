# Backend Configuration
PORT=8001
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration
# Default to SQLite for easy local dev, or set PostgreSQL URI:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/studyops
DATABASE_URL=sqlite:///./studyops.db

# Optional LLM API Key Configuration
# If no key is set, studyops uses its built-in NLP intent engine as a zero-breakage offline fallback!
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8001/api
